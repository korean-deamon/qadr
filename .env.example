# ---------------------------------------------------------------------------
# Qadr environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Values below are for local development (`uv run` / `npm run dev` on the host).
# docker-compose.yml overrides hostnames (db, redis, api) inside containers.
# For production copy this file to `.env.production` and follow the notes marked
# [prod] (see README → "Production").
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=development              # development | test | production
APP_NAME=Qadr
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 17) ----------------------------------------------
POSTGRES_USER=qadr
POSTGRES_PASSWORD=               # generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_DB=qadr
DATABASE_URL=postgresql+asyncpg://qadr:<POSTGRES_PASSWORD>@localhost:5433/qadr
TEST_DATABASE_URL=postgresql+asyncpg://qadr:<POSTGRES_PASSWORD>@localhost:5433/qadr_test

# --- Auth --------------------------------------------------------------------
SECRET_KEY=                      # >= 32 random chars; signs JWTs and hashes tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_MULTIPLIER=1          # 1 in production; e.g. 10 locally so e2e runs don't lock you out
TRUSTED_PROXY_HOPS=0             # proxies whose X-Forwarded-For is trusted (compose sets 1 for Caddy)

# --- Web / cookies -----------------------------------------------------------
FRONTEND_URL=http://localhost:3000            # public site origin (CSRF + links in bot messages) [prod] https://your-domain
CORS_ORIGINS=http://localhost:3000            # comma-separated allowed origins           [prod] https://your-domain
COOKIE_SECURE=false              # [prod] true (HTTPS only)
COOKIE_DOMAIN=                   # leave empty for host-only cookies

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
REDIS_PASSWORD=                  # [prod] required: docker-compose.prod.yml starts Redis with it

# --- Media ---------------------------------------------------------------------
# Leave all three empty to store uploads on local disk (MEDIA_ROOT). Set them to
# switch to Cloudinary (server-side signed uploads, f_auto/q_auto delivery).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_ROOT=./media

# --- Locales -------------------------------------------------------------------
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# --- Telegram bot (SPEC §22) ---------------------------------------------------
# Create a bot with @BotFather, then paste the token and the username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling            # polling (dev) | webhook (prod)
TELEGRAM_WEBHOOK_URL=            # public https origin, e.g. https://qadr.uz (webhook mode)
TELEGRAM_WEBHOOK_SECRET=         # random string; Telegram sends it back in a header
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10

# --- Google sign-in (optional; not a secret, empty disables the button) ----------
GOOGLE_CLIENT_ID=                # from Google Cloud Console; same value for NEXT_PUBLIC_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Frontend --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # public origin for canonical/hreflang (not a secret)
API_INTERNAL_URL=http://localhost:8000        # how the Next server reaches the API

# --- Docker ------------------------------------------------------------------------
HOST_UID=1000                    # dev compose: containers write ./server/media as this user (`id -u`)
# [prod] docker-compose.prod.yml only:
SITE_ADDRESS=:80                 # your domain (e.g. qadr.uz) → automatic HTTPS; ":80" = plain HTTP
HTTP_PORT=80
HTTPS_PORT=443
SEED_DEMO=false                  # true loads demo data on start (staging only)
IMAGE_PREFIX=qadr                # image names: <prefix>-server / -bot / -web
IMAGE_TAG=latest
