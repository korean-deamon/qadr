# ---------------------------------------------------------------------------
# Qadr environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Values below are for local development (`uv run` / `npm run dev` on the host).
# docker-compose overrides hostnames (db, redis, mailpit, api) inside containers.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_ENV=development              # development | test | production
APP_NAME=Qadr
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 17) ----------------------------------------------
POSTGRES_USER=qadr
POSTGRES_PASSWORD=               # generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_DB=qadr
DATABASE_URL=postgresql+asyncpg://qadr:<POSTGRES_PASSWORD>@localhost:5433/qadr
TEST_DATABASE_URL=postgresql+asyncpg://qadr:<POSTGRES_PASSWORD>@localhost:5433/qadr_test

# --- Auth --------------------------------------------------------------------
SECRET_KEY=                      # >= 32 random chars; signs JWTs and hashes tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_MULTIPLIER=1          # 1 in production; e.g. 10 locally so e2e runs don't lock you out

# --- Web / cookies -----------------------------------------------------------
FRONTEND_URL=http://localhost:3000            # public site origin (CSRF + links in emails)
CORS_ORIGINS=http://localhost:3000            # comma-separated allowed origins
COOKIE_SECURE=false              # true behind HTTPS (production)
COOKIE_DOMAIN=                   # leave empty for host-only cookies

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# --- Media ---------------------------------------------------------------------
# Leave all three empty to store uploads on local disk (MEDIA_ROOT). Set them to
# switch to Cloudinary (server-side signed uploads, f_auto/q_auto delivery).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_ROOT=./media

# --- Email -------------------------------------------------------------------
EMAIL_PROVIDER=smtp              # smtp | console | memory
EMAIL_API_KEY=                   # SMTP password/API key for a real relay (empty for Mailpit)
EMAIL_FROM=Qadr <no-reply@qadr.uz>
SMTP_HOST=localhost              # Mailpit in dev: UI at http://localhost:8025
SMTP_PORT=1025

# --- Locales -------------------------------------------------------------------
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# --- Telegram bot (SPEC §22) ---------------------------------------------------
# Create a bot with @BotFather, then paste the token and the username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling            # polling (dev) | webhook (prod)
TELEGRAM_WEBHOOK_URL=            # public https origin, e.g. https://qadr.uz (webhook mode)
TELEGRAM_WEBHOOK_SECRET=         # random string; Telegram sends it back in a header
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10

# --- Frontend --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # public origin for canonical/hreflang (not a secret)
API_INTERNAL_URL=http://localhost:8000        # how the Next server reaches the API
