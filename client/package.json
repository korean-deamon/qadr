{
  "name": "qadr-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run cn:build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "cn:build": "node -e \"import('cn/build').then(m=>m.build({content:['src/**/*.{ts,tsx}'],out:'src/lib/cn-tables.ts',css:'src/app/globals.css'}))\""
  },
  "dependencies": {
